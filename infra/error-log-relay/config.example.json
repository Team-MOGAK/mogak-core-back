{
  "schemaVersion": 1,
  "gcp": {
    "projectId": "my-mogak-project",
    "region": "asia-northeast3"
  },
  "source": {
    "apiService": "mogak-spring",
    "environment": "production",
    "producer": "mogak-core-api"
  },
  "relay": {
    "service": "mogak-spring-error-relay",
    "image": "asia-northeast3-docker.pkg.dev/my-mogak-project/mogak-relay/error-log-relay@sha256:REPLACE_WITH_STAGING_DIGEST",
    "serviceAccount": "error-log-relay@my-mogak-project.iam.gserviceaccount.com",
    "pushServiceAccount": "error-log-relay-push@my-mogak-project.iam.gserviceaccount.com",
    "timeoutSeconds": 15,
    "concurrency": 1,
    "minInstances": 0,
    "maxInstances": 3,
    "cpu": "1",
    "memory": "512Mi",
    "pushPath": "/pubsub/push"
  },
  "firestore": {
    "databaseId": "mogak-error-relay",
    "location": "asia-northeast3",
    "channelDocumentPath": "alertChannels/production-discord"
  },
  "secret": {
    "name": "discord-webhook",
    "version": "1"
  },
  "topics": {
    "source": "mogak-api-error-events",
    "quarantine": "mogak-error-quarantine",
    "deadLetter": "mogak-error-dead-letter"
  },
  "subscriptions": {
    "source": "mogak-api-error-relay",
    "quarantine": "mogak-error-quarantine-retained",
    "deadLetter": "mogak-error-dead-letter-retained"
  },
  "expectedSubscription": "projects/my-mogak-project/subscriptions/mogak-api-error-relay",
  "quarantineTopic": "projects/my-mogak-project/topics/mogak-error-quarantine",
  "sink": {
    "name": "mogak-api-error-to-relay",
    "metricName": "mogak-api-error-missing-alert-eligible",
    "enabled": false
  },
  "pubsub": {
    "ackDeadlineSeconds": 30,
    "minRetryDelaySeconds": 10,
    "maxRetryDelaySeconds": 600,
    "maxDeliveryAttempts": 100,
    "retentionDays": 7
  }
}
