{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/api/*"],
      "@core/*": ["libs/core/src/core/*"],
      "@infra/*": ["libs/modules/src/infrastructure/*"],
      "@mogak/core": ["libs/core/src"],
      "@mogak/core/*": ["libs/core/src/*"],
      "@mogak/modules": ["libs/modules/src"],
      "@mogak/modules/*": ["libs/modules/src/*"]
    },
    "module": "commonjs",
    "target": "ES2023",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "types": ["node", "jest", "multer"],
    "skipLibCheck": true
  },
  "include": ["apps/api/src/**/*.ts", "libs/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.ts"]
}
