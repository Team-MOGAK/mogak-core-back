{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/api/*"],
      "@core/*": ["apps/api/src/core/*"],
      "@infra/*": ["apps/api/src/infrastructure/*"],
      "@composition/*": ["apps/api/src/composition/*"]
    },
    "module": "commonjs",
    "target": "ES2023",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "types": ["node", "jest", "multer"],
    "skipLibCheck": true
  },
  "include": ["apps/api/src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.ts"]
}
